datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  customer
  provider
  admin
}

enum UserStatus {
  active
  suspended
}

enum OrderStatus {
  PLACED
  PENDING
  CONFIRMED
  APPROVED
  PAID
  PICKED_UP
  RETURNED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  pending
  completed
  failed
}

// Users Table
model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(customer)
  status    UserStatus @default(active)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  gearItems GearItem[]
  rentals   RentalOrder[]
  reviews   Review[]
}

// Categories Table
model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  gearItems GearItem[]
}

// Review Table
model Review {
  id        String   @id @default(uuid())
  rating    Int      // 1 to 5
  comment   String?
  gearId    String
  gear      GearItem @relation(fields: [gearId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, gearId])
}

// GearItems Table
model GearItem {
  id            String   @id @default(uuid())
  providerId    String
  categoryId    String
  title         String
  images        String[]
  description   String
  brand         String
  pricePerDay   Float
  stockQuantity Int
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  provider   User        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  reviews    Review[]
}

// RentalOrders Table
model RentalOrder {
  id         String      @id @default(uuid())
  customerId String
  startDate  DateTime
  endDate    DateTime
  totalPrice Float
  status     OrderStatus @default(PLACED)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Relations
  customer   User        @relation(fields: [customerId], references: [id])
  orderItems OrderItem[]
  payments   Payment[]
}

// OrderItems Table (Fixed Duplicate & Missing Fields)
model OrderItem {
  id       String @id @default(uuid())
  orderId  String
  gearId   String
  quantity Int

  // Relations
  order RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gear  GearItem    @relation(fields: [gearId], references: [id], onDelete: Cascade)
}

// Payments Table
model Payment {
  id            String        @id @default(uuid())
  orderId       String
  transactionId String        @unique
  amount        Float
  method        String // e.g., "Stripe" or "SSLCommerz"
  status        PaymentStatus @default(pending)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  // Relations
  order RentalOrder @relation(fields: [orderId], references: [id])
}
